{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_news_v1",
  "title": "Market News v1",
  "type": "object",
  "required": [
    "schema",
    "news_id",
    "provider",
    "source_url",
    "headline",
    "published_at",
    "observed_at",
    "retrieved_at",
    "affected_symbols",
    "themes",
    "confidence",
    "relevance",
    "status",
    "summary"
  ],
  "properties": {
    "schema": {"const": "market_news_v1"},
    "news_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "headline": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "affected_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "themes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "relevance": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["fresh", "stale", "contradicted"]},
    "summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
