  "properties":{
    "schema":{"const":"trading_dashboard_v1"},"generated_at":{"type":"string","format":"date-time"},"overall_status":{"enum":["HEALTHY","WAITING","DEGRADED","FAILING"]},"paper_ready":{"type":"boolean"},"readiness_blockers":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":80}},
    "subsystems":{"type":"object","additionalProperties":false,"required":["market_feed","azure_event_producer","chatgpt_brain","azure_executor","paper_account"],"properties":{"market_feed":{"$ref":"#/$defs/subsystem"},"azure_event_producer":{"$ref":"#/$defs/subsystem"},"chatgpt_brain":{"$ref":"#/$defs/subsystem"},"azure_executor":{"$ref":"#/$defs/subsystem"},"paper_account":{"$ref":"#/$defs/subsystem"}}},
