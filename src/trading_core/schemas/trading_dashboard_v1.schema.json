    "risk_rejects":{"type":"array","maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["event_id","occurred_at","reason_code"],"properties":{"event_id":{"type":"string","minLength":1,"maxLength":160},"occurred_at":{"type":"string","format":"date-time"},"reason_code":{"type":["string","null"],"maxLength":96}}}},
    "recent_activity":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/activity"}}
